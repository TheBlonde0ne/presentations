\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $\alpha -\text  {Fe}_2\text  {O}_3$ is a collinear antiferromagnetic insulator. A giant spontaneous Kerr effect ($\theta _K \approx 80 \text  { mdeg}$) is observed. The tiny net magnetization ($\Delta M \approx 0.006 \mu _B/\text  {Fe}$) is far too small to explain this signal. \cite  {yoshimochi2026large}}}{7}{}\protected@file@percent }
\newlabel{fig:fe2o3kerr}{{4}{7}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces First-principles calculations were performed for the easy-plane AFM state. Crucially, the simulation was run assuming zero net magnetization (M=0). The simulation perfectly reproduces the experimental Kerr rotation ($\theta _K$) and ellipticity ($\eta _K$). This includes the spectral shape, peak position (~2.5 eV), and absolute magnitude. This provides conclusive evidence that the giant MOKE is an intrinsic property of the $TtS$-broken AFM order itself. \cite  {yoshimochi2026large}}}{7}{}\protected@file@percent }
\newlabel{fig:fe2o3comp}{{5}{7}{}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Probing Diagonal Elements: Optical Conductivity}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Spins reorient along the c-axis during the "Morin transition" ($T < 260 \mathrm  { K}$). The spontaneous Kerr effect vanishes, proving it is tied to the specific AFM order.\cite  {yoshimochi2026large}}}{8}{}\protected@file@percent }
